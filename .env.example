# Copy to .env and adjust. Every variable is optional; defaults suit local development.
# No paid API keys are needed for any feature.

# --- backend (prefix NT_) ---
NT_ENVIRONMENT=development
# SQLite by default; for PostgreSQL:
# NT_DATABASE_URL=postgresql+psycopg2://news_tally:news_tally@localhost:5432/news_tally
NT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
NT_RATE_LIMIT_PER_MINUTE=30
NT_MAX_REQUEST_BYTES=64000
NT_RETENTION_DAYS=30
NT_ALLOW_URL_FETCH=true

# Retrieval thresholds (derived from ml/artifacts/retrieval_eval.json)
NT_STRONG_MATCH_THRESHOLD=0.60
NT_RELATED_MATCH_THRESHOLD=0.40

# Set to 1 to run retrieval lexical-only (no 470 MB embedding model; for small servers)
# NT_DISABLE_EMBEDDINGS=1
# HF_HUB_OFFLINE=1   # use the cached embedding model without network calls

# --- data collection ---
NT_REQUEST_DELAY=2.0

# --- frontend (Vite) ---
# VITE_API_URL=https://your-backend.onrender.com
